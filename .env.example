# ─── Режим провижена ───
# stub = имитация создания канала (без ноды, для локальной разработки)
# real = настоящий провижн через ноду по SSH
PROVISION_MODE=real

# ─── Bedolaga: вебхук и REST API ───
# Секрет вебхука (проверка HMAC-подписи входящих вебхуков). Пусто = проверка выключена.
BEDOLAGA_WEBHOOK_SECRET=
# Базовый URL REST API бота и Bearer-токен (создаётся в Bedolaga: POST /tokens).
# Из контейнера в одной сети со стеком Bedolaga — по имени сервиса.
BEDOLAGA_API_URL=http://remnawave_bot:8080
BEDOLAGA_API_TOKEN=
# Токен бота (BOT_TOKEN из конфига Bedolaga): мост шлёт поздравление напрямую
# через Telegram Bot API (в API бота нет ручки уведомления пользователя).
TELEGRAM_BOT_TOKEN=

# ─── Публичный адрес моста ───
# На него ведёт ссылка в поздравлении (телефон пользователя должен достучаться).
BRIDGE_PUBLIC_URL=https://orca.example.com

# ─── Определение тарифа FULL ───
# Сквады, которые вместе означают FULL (через запятую). FULL = подписка содержит
# ВСЕ эти сквады. Пусто = считать FULL любую активную подписку.
FULL_SQUADS=

# ─── Безопасность ссылки /connect ───
# user_id зашит в подписанный токен — подделать/перебрать ссылку нельзя.
# LINK_SECRET пусто = переиспользуется BEDOLAGA_WEBHOOK_SECRET.
LINK_SECRET=
LINK_TTL_DAYS=365

# ─── Текст поздравления ───
# \n = перенос строки; в тексте допустим HTML (parse_mode=HTML).
CONGRATS_MESSAGE=🐋 <b>Поздравляем с тарифом FULL!</b>\n\nВам доступен дополнительный обход белых списков.
CONGRATS_BUTTON=Подключить обход →

# ─── Крон-сверка каналов ───
# Удаляет каналы юзеров без активной FULL:
#   off (по умолчанию) | dryrun (только лог) | on (реально удалять)
# ВСЕГДА прогоняй сначала dryrun и смотри лог, прежде чем ставить on.
RECONCILE_MODE=off
RECONCILE_INTERVAL=600

# ─── Доступ к ноде по SSH ───
# user@host ноды, порт и путь к приватному ключу внутри контейнера
# (монтируется в docker-compose.yml).
OPENFLUX_NODE=root@NODE_IP
SSH_PORT=22
SSH_KEY=/keys/openflux-bridge

# ─── Клиентские приложения для страницы /connect ───
# Android: мост сам отдаёт apk с /download/android (скачивается ./fetch-apk.sh в apk/).
# Если локального apk нет — редирект на APK_URL_ANDROID (fallback).
APK_URL_ANDROID=https://github.com/p1neappleXpress/OpenFluxAndroid/releases/latest
# iOS: ссылка-приглашение TestFlight.
TESTFLIGHT_URL_IOS=https://testflight.apple.com/join/XXXXXXXX
